# Firebase Configuration
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_API_KEY=your_api_key

# App Configuration
APP_NAME=Mobile App For Shops
APP_VERSION=1.0.0

# Security
MIN_PASSWORD_LENGTH=8

# Database
DATABASE_NAME=shops.db
DATABASE_VERSION=1

# Sync Configuration
SYNC_INTERVAL_SECONDS=300
API_TIMEOUT_SECONDS=30

# Firestore Collections
FIRESTORE_USERS_COLLECTION=users
FIRESTORE_SHOPS_COLLECTION=shops
FIRESTORE_ITEMS_COLLECTION=items
FIRESTORE_ORDERS_COLLECTION=orders

# SQLite Tables
SQLITE_USERS_TABLE=users_local
SQLITE_SHOPS_TABLE=shops_local
SQLITE_ITEMS_TABLE=items_local
SQLITE_SYNC_QUEUE_TABLE=sync_queue
SQLITE_SYNC_METADATA_TABLE=sync_metadata

# Platform-specific
IOS_MINIMUM_VERSION=11.0
ANDROID_MINIMUM_API=21
