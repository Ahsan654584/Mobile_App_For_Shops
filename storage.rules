rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Images can be read by any authenticated user
    match /images/{imageId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
        request.auth.uid == imageId.split('_')[0]; // User can only write their own images
    }

    // Product images - admin write, all authenticated read
    match /products/{productId}/{imageId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
        request.auth.token.role == 'admin';
    }

    // Profile pictures - user-specific
    match /profiles/{userId}/{imageId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
        request.auth.uid == userId;
    }

    // General uploads with size limits
    match /uploads/{userId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
        request.auth.uid == userId &&
        request.resource.size < 5 * 1024 * 1024; // 5MB limit
    }
  }
}